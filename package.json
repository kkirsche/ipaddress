{
  "name": "@ipaddress/core",
  "version": "2.0.0",
  "description": "A TypeScript port of Python's ipaddress module: create, inspect and manipulate IPv4 and IPv6 addresses, interfaces and networks",
  "keywords": [
    "ip address",
    "ip",
    "ipv4",
    "ipv6",
    "ipaddress",
    "cidr",
    "subnet",
    "network",
    "netmask",
    "python"
  ],
  "homepage": "https://github.com/kkirsche/ipaddress#readme",
  "bugs": {
    "url": "https://github.com/kkirsche/ipaddress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkirsche/ipaddress.git"
  },
  "author": {
    "name": "Kevin Kirsche",
    "email": "kev.kirsche@gmail.com"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "fixtures": "python3 scripts/generate_fixtures.py src/__fixtures__/python-ipaddress.json && python3 scripts/record_cpython_tests.py src/__fixtures__/cpython-test-suite.json",
    "format": "prettier -w src",
    "lint": "eslint src",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn build",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn test"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "embeddedLanguageFormatting": "auto",
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxSingleQuote": false,
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "vueIndentScriptAndStyle": false
  },
  "packageManager": "yarn@3.6.0"
}
